# Copie ce fichier en .env et remplis les valeurs avant le premier démarrage
# (docker compose up -d). Rien d'autre ne va dans .env : la connexion à ton hyperviseur,
# ton IPAM, ton GLPI, ton dépôt Git de playbooks se configurent APRÈS démarrage, depuis
# l'interface web (/connections) ou la CLI (python -m app.cli connection ...) — jamais
# dans ce fichier.

POSTGRES_USER=vmprov
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vmprovisioning

DATABASE_URL=postgresql+psycopg://vmprov:changeme@postgres:5432/vmprovisioning
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=vm-provisioning

# Signe les cookies de session (dashboard) — génère une vraie valeur aléatoire :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=changeme-generate-a-real-random-value

# Compte intermédiaire déployé par Ansible sur chaque VM créée (jamais root direct en
# SSH — voir le playbook vm-hardening/harden-root.yml du dépôt de playbooks).
ANSIBLE_ADMIN_USERNAME=admin
# Mot de passe de ce compte (sert aussi de mot de passe sudo/become) — génère une vraie
# valeur avant tout usage réel, ne laisse jamais "changeme" en prod.
ANSIBLE_ADMIN_PASSWORD=changeme

# Chemins (dans le conteneur, via le volume ./.secrets) vers les clés SSH à générer
# toi-même avant le premier démarrage — voir le Quickstart du README :
#   - vmprov_bastion_key  : clé d'automatisation, déployée sur chaque VM créée
#   - vmprov_gitea_key    : clé dédiée en LECTURE SEULE pour cloner ton dépôt de
#                           playbooks Ansible (jamais la même clé que la précédente —
#                           une clé pour récupérer le contenu, une autre pour déployer)
ANSIBLE_SSH_PRIVATE_KEY_PATH=/app/.secrets/vmprov_bastion_key
GITEA_SSH_PRIVATE_KEY_PATH=/app/.secrets/vmprov_gitea_key
